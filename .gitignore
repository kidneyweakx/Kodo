# --- Gadgetbridge upstream source tree (kept for reference, not part of our build) ---
/Gadgetbridge/

# --- node ---
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- expo / react native ---
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# --- ios / android build artifacts (we'll commit native projects but ignore build output) ---
ios/Pods/
ios/build/
ios/.xcode.env.local
ios/*.xcworkspace/xcuserdata/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
*.keystore
!debug.keystore

# --- nitro codegen output (regenerated) ---
nitrogen/generated/

# --- env / secrets ---
.env
.env.*.local
*.p8
*.p12
*.key
google-services.json
GoogleService-Info.plist

# --- editors / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.iml
*.log
*.tsbuildinfo

# --- test / coverage ---
coverage/
junit.xml
