    },
    "SystemControl": {
      "cpp": "HybridSystemControl",
      "swift": "HybridSystemControl",
      "kotlin": "HybridSystemControl"
    },
    "MusicBridge": {
      "cpp": "HybridMusicBridge",
      "swift": "HybridMusicBridge",
      "kotlin": "HybridMusicBridge"
    },
    "WeatherBridge": {
      "cpp": "HybridWeatherBridge",
      "swift": "HybridWeatherBridge",
      "kotlin": "HybridWeatherBridge"
    },
    "CalendarBridge": {
      "cpp": "HybridCalendarBridge",
      "swift": "HybridCalendarBridge",
      "kotlin": "HybridCalendarBridge"
    }
  },
  "ignorePaths": ["node_modules", "Gadgetbridge"]
