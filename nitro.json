    "HybridHealthStore": { "android": { "language": "kotlin", "implementationClassName": "HybridHealthStore" } },
    "HybridNotificationBridge": { "android": { "language": "kotlin", "implementationClassName": "HybridNotificationBridge" } },
    "HybridSystemControl": { "android": { "language": "kotlin", "implementationClassName": "HybridSystemControl" } },
    "HybridMusicBridge": { "android": { "language": "kotlin", "implementationClassName": "HybridMusicBridge" } },
    "HybridWeatherBridge": { "android": { "language": "kotlin", "implementationClassName": "HybridWeatherBridge" } },
    "HybridCalendarBridge": { "android": { "language": "kotlin", "implementationClassName": "HybridCalendarBridge" } },
    "HybridCameraRemote": { "android": { "language": "kotlin", "implementationClassName": "HybridCameraRemote" } },
    "HybridGpsTracker": { "android": { "language": "kotlin", "implementationClassName": "HybridGpsTracker" } },
    "HybridSedentary": { "android": { "language": "kotlin", "implementationClassName": "HybridSedentary" } },
    "HybridWeatherProvider": { "android": { "language": "kotlin", "implementationClassName": "HybridWeatherProvider" } },
    "HybridHealthConnect": { "android": { "language": "kotlin", "implementationClassName": "HybridHealthConnect" } },
